<Project Sdk="Microsoft.NET.Sdk">

  <!-- A Roslyn source generator: a plain class library the Intropy.Framework.Components package
       ships as an analyzer. It must not reference the components themselves — it sees them only
       as compilation symbols. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- The Components package bundles this analyzer; it is not a standalone package. -->
    <IsPackable>false</IsPackable>
    <!-- The generator breaks three analyzer rules on purpose, and opts out of the bookkeeping ones:
         RS1035 bans file IO and non-incremental generators — the scaffold record is a file the
         system tooling reads, out of tree, and a record for a whole project is not a per-node
         transformation worth an incremental pipeline. RS2008 and RS1042 want release tracking for
         a rule set that ships unreleased with the feature. CA1308 is declined: the record's
         blockKind and payloads are identifiers, lowercased the invariant way. -->
    <NoWarn>$(NoWarn);RS1035;RS1032;RS1036;RS1042;RS2008;CA1308</NoWarn>
    <Description>Build-time companion of Intropy.Framework.Components: reads the IntropyComponent attribute and writes the scaffold record (.intropy/scaffold.json) the system tooling assembles the system from.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
