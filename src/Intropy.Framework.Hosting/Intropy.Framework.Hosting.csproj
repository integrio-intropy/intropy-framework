<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Runtime orchestration (Dapr sidecar lifecycle, idle timeout, message subscription) for the Intropy.Framework pipeline framework.</Description>
    <PackageTags>intropy;pipeline;integration;framework;hosting;dapr</PackageTags>
  </PropertyGroup>

  <!-- Kestrel hosts the gRPC app callback a loader receives its messages on under the
       app-callback transport. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Intropy.Framework.Blocks\Intropy.Framework.Blocks.csproj" />
    <ProjectReference Include="..\Intropy.Framework.Adapters\Intropy.Framework.Adapters.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapr.Client" />
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>

</Project>
